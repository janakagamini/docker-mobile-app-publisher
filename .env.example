# =============================================================================
# Shared Configuration (Artifactory & Release Metadata)
# =============================================================================
# Optional Artifactory authentication header (e.g., "X-JFrog-Art-Api: <token>" or "Authorization: Bearer <token>")
ARTIFACTORY_AUTH_HEADER=
RELEASE_NOTES=Automated CD build 1.0.0

# -----------------------------------------------------------------------------
# Track 1: Firebase App Distribution — Android AAB (firebase-aab)
# -----------------------------------------------------------------------------
FIREBASE_AAB_ARTIFACT_URL=http://artifactory.corp.internal/generic-local/mobile-app-aab/9.0.0/app-release.aab
FIREBASE_AAB_APP_ID=1:123456789012:android:abcdef1234567890

# -----------------------------------------------------------------------------
# Track 2: Firebase App Distribution — iOS IPA (firebase-ipa)
# -----------------------------------------------------------------------------
FIREBASE_IPA_ARTIFACT_URL=http://artifactory.corp.internal/generic-local/mobile-app-ipa/3.0.0/app-release.ipa
FIREBASE_IPA_APP_ID=1:123456789012:ios:abcdef1234567890

# Shared Firebase tester distribution settings (optional)
TESTER_GROUPS=
TESTERS=
FIREBASE_DEBUG=false

# -----------------------------------------------------------------------------
# Track 3: Google Play Console — Android AAB (playstore-aab)
# -----------------------------------------------------------------------------
PLAYSTORE_AAB_ARTIFACT_URL=http://artifactory.corp.internal/generic-local/mobile-app-aab/9.0.0/app-release.aab
PLAYSTORE_PACKAGE_NAME=com.foo.bar.testdockerapp
PLAYSTORE_TRACK=internal
PLAYSTORE_RELEASE_STATUS=draft
PLAYSTORE_RELEASE_NOTES_LANG=en-US
PLAYSTORE_DEBUG=false

# -----------------------------------------------------------------------------
# Track 4: Apple App Store Connect — iOS IPA (appstore-ipa)
# -----------------------------------------------------------------------------
APPSTORE_IPA_ARTIFACT_URL=http://artifactory.corp.internal/generic-local/mobile-app-ipa/4.0.0/app-release.ipa
APPSTORE_ISSUER_ID=00000000-0000-0000-0000-000000000000
APPSTORE_KEY_ID=ABC1234567
# Numeric Apple ID of the app in App Store Connect (or leave blank and set APPSTORE_BUNDLE_ID)
APPSTORE_APP_ID=1234567890
APPSTORE_BUNDLE_ID=com.foo.bar.testdockerapp
# Optional overrides (auto-extracted from Payload/*.app/Info.plist inside .ipa if omitted)
APPSTORE_BUNDLE_SHORT_VERSION=
APPSTORE_BUNDLE_VERSION=
APPSTORE_PLATFORM=IOS
APPSTORE_DEBUG=false

# -----------------------------------------------------------------------------
# Track 5: Huawei AppGallery Connect — Android AAB/APK (appgallery-aab)
# -----------------------------------------------------------------------------
HUAWEI_AAB_ARTIFACT_URL=http://artifactory.corp.internal/generic-local/mobile-app-aab/9.0.0/app-release.aab
# App ID from AppGallery Connect -> My apps -> App information
HUAWEI_APP_ID=1234567890
# API Client credentials from AppGallery Connect -> Users and permissions -> API key -> Connect API
# (Can also be loaded from ./credentials/huawei-api-client.json)
HUAWEI_CLIENT_ID=1234567890123456789
HUAWEI_CLIENT_SECRET=replace-with-huawei-connect-api-client-secret
# Optional overrides:
# - Global: https://connect-api.cloud.huawei.com (default)
# - EU:     https://connect-api-dr.cloud.huawei.com
# - Asia:   https://connect-api-ce.cloud.huawei.com
HUAWEI_API_BASE_URL=https://connect-api.cloud.huawei.com
# 1 = formal release (entire network), 3 = phased release
HUAWEI_RELEASE_TYPE=1
# Set to true to call POST /api/publish/v2/app-submit after attaching the binary to the draft
HUAWEI_SUBMIT_FOR_REVIEW=false
HUAWEI_DEBUG=false

# -----------------------------------------------------------------------------
# Track 6: Firebase Crashlytics — R8/ProGuard Mapping Upload (crashlytics-mapping)
# -----------------------------------------------------------------------------
CRASHLYTICS_MAPPING_FILE_URL=http://artifactory.corp.internal/generic-local/mobile-app-aab/9.0.0/mapping.txt
CRASHLYTICS_RESOURCE_FILE_URL=http://artifactory.corp.internal/generic-local/mobile-app-aab/9.0.0/com_google_firebase_crashlytics_mappingfileid.xml
CRASHLYTICS_APP_ID=1:123456789012:android:abcdef1234567890
CRASHLYTICS_DEBUG=false
